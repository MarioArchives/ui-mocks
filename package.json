{
  "name": "quest-mocks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phone-first UI mocks for Quest-Game: try a screen in your hand before it is built.",
  "scripts": {
    "dev": "vite --host",
    "phone": "node scripts/phone.mjs",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
